<!-- Structural wiring only: id, name, vendor, version and description are declared in
     build.gradle.kts (pluginConfiguration) so there is a single source of truth. -->
<idea-plugin>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <!-- Optional language integrations: the descriptor is only loaded when the plugin is present. -->
    <depends optional="true" config-file="tunnelvision-kotlin.xml">org.jetbrains.kotlin</depends>
    <depends optional="true" config-file="tunnelvision-javascript.xml">JavaScript</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService
            serviceImplementation="io.github.leolaurindo.tunnelvision.settings.TunnelVisionSettings"/>
        <applicationService
            serviceImplementation="io.github.leolaurindo.tunnelvision.core.TunnelVisionCore"/>

        <!-- Focus state must not outlive the editor it belongs to. -->
        <editorFactoryListener
            implementation="io.github.leolaurindo.tunnelvision.core.EditorReleaseListener"/>

        <applicationConfigurable
            parentId="tools"
            instance="io.github.leolaurindo.tunnelvision.settings.TunnelVisionConfigurable"/>

        <notificationGroup id="TunnelVision" displayType="BALLOON"/>

        <colorSettingsPage
            implementation="io.github.leolaurindo.tunnelvision.ui.TunnelVisionColorSettingsPage"/>
        <additionalTextAttributes scheme="Default" file="colorSchemes/TunnelVisionDefault.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/TunnelVisionDarcula.xml"/>
    </extensions>

    <!-- The Kotlin integration reads Kotlin PSI only, which both plugin modes provide. -->
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK1="true" supportsK2="true"/>
    </extensions>

    <actions>
        <action id="TunnelVision.Toggle"
                class="io.github.leolaurindo.tunnelvision.actions.ToggleFocusAction"
                text="Toggle Focus"
                description="Keep or release focus on the symbol under the caret">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="TunnelVision.Enable"
                class="io.github.leolaurindo.tunnelvision.actions.EnableFocusAction"
                text="Enable Focus"
                description="Replace existing tracks with the symbol under the caret"/>
        <action id="TunnelVision.Add"
                class="io.github.leolaurindo.tunnelvision.actions.AddFocusAction"
                text="Add Focus"
                description="Track another symbol without releasing existing focus">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="TunnelVision.Pin"
                class="io.github.leolaurindo.tunnelvision.actions.PinFocusAction"
                text="Pin Focus"
                description="Keep a fixed symbol alongside dynamic focus">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="TunnelVision.Remove"
                class="io.github.leolaurindo.tunnelvision.actions.RemoveFocusAction"
                text="Remove Focus"
                description="Remove the track under the caret or the most recent track">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="TunnelVision.Disable"
                class="io.github.leolaurindo.tunnelvision.actions.DisableFocusAction"
                text="Disable Focus"
                description="Release focus in the current editor"/>
        <action id="TunnelVision.NextMatch"
                class="io.github.leolaurindo.tunnelvision.actions.NextMatchAction"
                text="Next Match"
                description="Move the caret to the next occurrence across all tracks">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt DOWN"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="TunnelVision.PreviousMatch"
                class="io.github.leolaurindo.tunnelvision.actions.PreviousMatchAction"
                text="Previous Match"
                description="Move the caret to the previous occurrence across all tracks">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt UP"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
